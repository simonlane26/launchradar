# Copy to .env and fill in. Never commit .env.

# Public site origin — used for canonical URLs, OpenGraph, sitemap.xml and
# robots.txt. No trailing slash. Leave blank in dev (falls back to
# http://localhost:3000); set to the real origin in production.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container id (GTM-XXXXXXX). When set, GTM loads on every
# page and all analytics / marketing tags are then configured in the GTM
# dashboard, not in this repo. Public by design — it ships in the HTML. Leave
# blank to disable GTM entirely (e.g. in dev).
NEXT_PUBLIC_GTM_ID=

# Postgres connection string (Prisma)
DATABASE_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Anthropic (Claude API) — used for the analysis pipeline
ANTHROPIC_API_KEY=

# Admin bypass — comma/space separated Clerk *user* ids (user_...) that get
# unlimited access on every plan gate, in every org they open. This is how
# the project owner keeps full access; leave blank in normal deployments.
ADMIN_CLERK_USER_IDS=

# VibeCheck (sibling security product). When set, an analysis whose Growth
# Score "Trust" dimension is weak and shows no security assurance of its own
# gets a Trust-category action, "Run a security check and show the result",
# linking here. Leave blank to disable that action entirely.
VIBECHECK_URL=

# Resend (https://resend.com) — the landing "first-users playbook" signup
# autoresponder. Optional: without RESEND_API_KEY the form still captures
# addresses to the `subscribers` table, it just doesn't send until you set
# the key and verify a sending domain. RESEND_FROM must be on that domain.
RESEND_API_KEY=
RESEND_FROM="LaunchRadar <hello@launchradar.app>"

# Stripe billing (https://dashboard.stripe.com). Read by /api/webhooks/stripe
# and src/app/billing/actions.ts. Leave STRIPE_SECRET_KEY blank to disable
# billing (checkout falls back to "Go to dashboard"). Use test-mode values
# (sk_test_… / whsec_…) until going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs from the Stripe product catalogue (price_…), one per
# plan × cadence. Builder £12/mo · £115/yr, Growth £24/mo · £229/yr.
STRIPE_PRICE_BUILDER_MONTHLY=
STRIPE_PRICE_BUILDER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
